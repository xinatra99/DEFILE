  "narrative": {
    "northStar": "The Graphite Research Workbench",
    "overview": "A precise, quiet operating interface derived from the parent portfolio's monochrome surfaces and restrained typography. Neutral controls and small tonal steps let scan state, findings and technical evidence carry the visual emphasis.\n\nDensity serves investigation: compact history sits beside a readable report workspace, complete values remain available, and large displays gain capacity rather than oversized type. This records the implemented Stage 2A system, not a replacement proposal. Visual authority and surface composition remain in `.validation/stage2a/direction.md`; source truth is `service/web/workbench.css`, `evidence.css`, `index.html`, `interface.js` and `workbench.js`.",
    "keyCharacteristics": [
      "Graphite and neutral light surfaces with semantic state color.",
      "Local semibold headings, system UI text and monospace evidence.",
      "Bordered, flat containers and restrained small-radius controls.",
      "Persistent scan context with locally contained overflow."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Reserve severity and status colors for the meaning already attached to the underlying data; retain their text labels and theme-specific ink pairings.",
        "section": "colors"
      },
      {
        "name": "The Complete Value Rule",
        "body": "Truncate only the compact overview; retain a full-value detail, selectable text, tooltip or existing drill-down for the technical value.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** extend the source theme tokens and retain all seven persisted theme keys.",
      "**Do** keep semantic state labels, visible focus and complete technical values available.",
      "**Do** contain wide evidence and tables inside their own scroll regions.",
      "**Do** preserve the native API, engine and evidence-encoding boundaries."
    ],
    "donts": [
      "**Don't** use severity colors as decorative brand accents.",
      "**Don't** enlarge desktop typography merely because the workspace is wider.",
      "**Don't** restore shadows removed by the final flat-surface overrides.",
      "**Don't** rewrite protected evidence, fabricate integration states or modify the portfolio during UI work."
    ]
  }
